.paper-app { background-color:#fffefa; color:#20201e; }
.paper-app .unity-label { white-space:normal; flex-shrink:1; -unity-text-align:upper-left; }
.paper-app .paper-button { min-height:48px; margin:2px 0; padding:10px 16px; border-width:0; border-radius:14px; color:#20201e; background-color:#f2f0e9; white-space:normal; -unity-text-align:middle-center; flex-shrink:0; transition-property:background-color,color; transition-duration:120ms; transition-timing-function:ease-out; }
.paper-app .paper-button.primary { background-color:#ffe15a; }
.paper-app .paper-button.quiet { background-color:transparent; }
.paper-app .paper-button.danger { background-color:#fff7f4; color:#a62920; }
.paper-app .paper-button:hover { background-color:#e8e6df; border-width:0; }
.paper-app .paper-button.primary:hover { background-color:#f5d448; }
.paper-app .paper-button:active { background-color:#dcd9cf; border-width:0; }
.paper-app .paper-button.primary:active { background-color:#e9c83e; }
.paper-app .paper-button:disabled { opacity:1; color:#68665f; background-color:#ebe9e2; }
.paper-app .paper-button.auth-provider-apple,.paper-app .paper-button.auth-provider-google { min-height:54px; color:#20201e; background-color:#ffffff; border-width:0; }
.paper-app .paper-button.auth-provider-apple:hover,.paper-app .paper-button.auth-provider-google:hover { background-color:#f2f0e9; }
.paper-app .paper-button.auth-provider-apple:active,.paper-app .paper-button.auth-provider-google:active { background-color:#e6e3da; }
.paper-app .paper-button.auth-provider-apple:disabled,.paper-app .paper-button.auth-provider-google:disabled { color:#68665f; background-color:#ebe9e2; }
.paper-app .paper-button.camera-close { background-color:#fffefa; }
.paper-app .paper-button.camera-close:hover { background-color:#e8e6df; }
.paper-app .paper-button.camera-close:active { background-color:#dcd9cf; }
.paper-app .icon-button { min-width:48px; padding:10px; align-items:center; justify-content:center; }
.paper-app .paper-selection { min-height:52px; padding-right:32px; -unity-text-align:middle-left; border-width:0; }
.paper-app .paper-selection.selected { background-color:#fff6d2; }
.paper-app .selection-check { position:absolute; right:10px; top:17px; }
.paper-app .paper-button:focus { border-width:0; background-color:#d4d0c4; }
.paper-app .paper-button.primary:focus { background-color:#e7c43a; }
.paper-app .paper-button.quiet:focus,.paper-app .paper-button.auth-provider-apple:focus,.paper-app .paper-button.auth-provider-google:focus,.paper-app .paper-button.camera-close:focus { background-color:#dfdcd1; }
.paper-app .paper-button.danger:focus { background-color:#f0d7d0; }
.paper-app .paper-selection.selected:focus { background-color:#f2dfa0; }
.paper-app .paper-button:focus:active { background-color:#c7c2b5; }
.paper-app .paper-button.primary:focus:active { background-color:#ddba2f; }
.paper-app .paper-button.danger:focus:active { background-color:#e7c8c0; }
.paper-app .paper-selection.selected:focus:active { background-color:#e9d18a; }
/* Home tabs are small paper labels, with the longer title given more width. */
.paper-app .paper-button.home-section-tab { min-height:60px; margin:0 3px; padding:10px 9px; border-radius:3px; background-color:#fffaf0; color:#20201e; -unity-text-align:middle-center; white-space:nowrap; overflow:visible; }
.paper-app .paper-button.home-section-tab.selected { background-color:#f7e6b7; }
.paper-app .paper-button.home-section-tab:hover { background-color:#f4ecdd; }
.paper-app .paper-button.home-section-tab.selected:hover { background-color:#f0dda8; }
.paper-app .paper-button.home-section-tab:focus { background-color:#eee2cb; }
.paper-app .paper-button.home-section-tab.selected:focus { background-color:#ebd395; }
.paper-app .paper-button.home-section-tab:active,.paper-app .paper-button.home-section-tab:focus:active { background-color:#e8d8b9; }
.paper-app .paper-field { margin-top:12px; color:#20201e; min-height:76px; flex-direction:column; align-items:stretch; flex-shrink:0; min-width:0; }
.paper-app .paper-field.multiline { min-height:172px; }
.paper-app .paper-field .unity-base-field__label { width:auto; min-width:0; align-self:stretch; margin-bottom:7px; color:#20201e; white-space:normal; }
.paper-app .paper-field .unity-base-text-field__input { width:100%; flex-shrink:0; min-height:48px; padding:11px 12px; border-width:1px; border-color:#cbc9c1; border-radius:12px; background-color:#ffffff; color:#20201e; white-space:normal; }
.paper-app .paper-field.multiline .unity-base-text-field__input { min-height:110px; }
.paper-app .paper-field.is-focused .unity-base-text-field__input { border-width:2px; border-color:#20201e; }
.paper-app .paper-field.invalid .unity-base-text-field__input { border-color:#a62920; background-color:#fff7f4; }
.paper-app .paper-field:disabled .unity-base-text-field__input { color:#68665f; background-color:#ebe9e2; }
.paper-app .field-support { width:100%; flex-direction:row; justify-content:space-between; margin-top:5px; }
.paper-app .field-messages { flex-grow:1; flex-shrink:1; }
.paper-app .field-helper,.paper-app .field-counter { color:#5c5b55; font-size:13px; }
.paper-app .field-error { color:#a62920; font-size:13px; }
.paper-app .field-counter { margin-left:8px; }
.paper-app .paper-switch { min-height:56px; margin:4px 0; color:#20201e; }
.paper-app .paper-switch .unity-toggle__text { display:none; }
.paper-app .paper-switch .unity-toggle__checkmark { display:none; }
.paper-app .paper-switch .unity-toggle__input { flex-direction:row; align-items:center; min-height:56px; }
.paper-app .switch-copy { flex-grow:1; flex-shrink:1; }
.paper-app .switch-track { width:48px; height:28px; border-radius:14px; background-color:#cbc9c1; margin-left:12px; justify-content:center; }
.paper-app .paper-switch:checked .switch-track { background-color:#ffe15a; }
.paper-app .switch-thumb { position:absolute; left:3px; top:3px; width:22px; height:22px; border-radius:11px; background-color:#20201e; }
.paper-app .paper-switch:focus .switch-track { border-width:2px; border-color:#20201e; }
.paper-app .paper-scroll .unity-scroller--vertical,.paper-app .paper-scroll .unity-scroller--horizontal { display:none; }
.paper-app .paper-nav { flex-direction:row; min-height:80px; align-items:center; padding:5px 12px 7px; border-top-width:1px; border-top-color:#e2e0d7; background-color:#fffefa; }
.paper-app .paper-nav-item { flex-grow:1; flex-basis:0; min-width:48px; min-height:68px; margin:0 3px; padding:4px; flex-direction:column; align-items:center; justify-content:center; background-color:transparent; border-radius:14px; }
.paper-app .paper-nav-item .nav-art { width:38px; height:38px; flex-shrink:0; }
.paper-app .paper-nav-item .nav-label { font-size:12px; margin-top:3px; }
.paper-app .paper-nav-item.nav-stick { background-color:#ffe15a; }
.paper-app .paper-nav-item.nav-stick.nav-unselected { color:#20201e; }
.paper-app .paper-nav-item.nav-selected { color:#20201e; }
.paper-app .paper-nav-item.nav-unselected { color:#696861; }
.paper-app .nav-selection-marker { width:12px; height:2px; border-radius:1px; background-color:#20201e; margin-top:3px; }
.paper-app .sheet-scrim { position:absolute; left:0; top:0; right:0; bottom:0; background-color:rgba(0,0,0,0.38); }
.paper-app .paper-sheet { position:absolute; left:0; right:0; bottom:0; max-height:82%; padding:8px 20px 18px; border-top-left-radius:24px; border-top-right-radius:24px; background-color:#fffefa; }
.paper-app .sheet-grip { min-height:20px; align-items:center; justify-content:center; }
.paper-app .drawer-handle { width:36px; height:4px; border-radius:2px; background-color:#cbc9c1; }
.paper-app .sheet-heading { flex-direction:row; min-height:52px; align-items:center; justify-content:space-between; }
.paper-app .sheet-title { font-size:22px; color:#20201e; }
.paper-app .drawer-scroll { flex-shrink:1; min-height:0; }
.paper-app .drawer-scroll .unity-scroller--vertical,.paper-app .drawer-scroll .unity-scroller--horizontal { display:none; }
.paper-app .paper-notice { min-height:44px; flex-direction:row; align-items:center; padding:9px 12px; background-color:#f2f0e9; border-radius:12px; }
.paper-app .paper-notice.error { background-color:#fff0ec; color:#93271e; }
.paper-app .paper-notice.success { background-color:#ecf6e9; color:#2b653a; }
.paper-app .paper-notice .notice-copy { flex-grow:1; flex-shrink:1; margin-left:8px; }
.paper-app.reduced-motion .paper-button { transition-duration:0ms; }

.paper-app .paper-button.camera-close { width:48px; height:48px; min-width:48px; min-height:48px; margin:0 10px 0 0; padding:0; border-radius:24px; }
.paper-app .camera-title-sticker { background-color:#fffefa; min-height:48px; padding:10px 14px; justify-content:center; flex-shrink:0; }

/* Dotted stationery accents share geometry while controls retain native picking. */
.paper-app .paper-die-cut { border-radius:14px; }
.paper-app .sticker-sheet-heading { padding:12px 14px; margin-left:12px; margin-right:12px; }
.paper-app .paper-button.camera-book-button { flex-direction:column; align-items:center; justify-content:center; padding-top:6px; padding-bottom:6px; background-color:#fffefa; }
.paper-app .paper-button.camera-book-button:hover { background-color:#f2f0e9; }
.paper-app .paper-button.camera-book-button:active,.paper-app .paper-button.camera-book-button:focus { background-color:#dfdcd1; }

/* Login owns its provider styling independently of the paper action buttons. */
.login-backdrop { position:absolute; left:0; right:0; top:0; bottom:0; background-size:cover; background-position:center; }
.login-header { flex-shrink:0; align-items:center; justify-content:center; padding:16px 24px 0; background-color:transparent; }
.login-header .unity-label { -unity-text-align:middle-center; margin:0; }
.login-tagline { margin-top:8px; }
.login-space { flex-grow:1; flex-shrink:1; min-height:0; }
.login-actions { flex-shrink:0; padding:12px 24px 12px; background-color:transparent; }
.login-provider { min-height:52px; margin:0; padding:12px 16px; border-width:1px; border-radius:8px; flex-direction:row; align-items:center; justify-content:center; flex-shrink:0; }
.login-provider.auth-provider-apple { background-color:#000000; border-color:#000000; color:#ffffff; margin-bottom:12px; }
.login-provider.auth-provider-google { background-color:#ffffff; border-color:#747775; color:#1f1f1f; }
.login-provider.auth-provider-apple:hover,.login-provider.auth-provider-apple:focus { background-color:#292929; border-color:#747775; }
.login-provider.auth-provider-apple:active { background-color:#414141; }
.login-provider.auth-provider-google:hover,.login-provider.auth-provider-google:focus { background-color:#f2f2f2; }
.login-provider.auth-provider-google:active { background-color:#e8e8e8; }
.login-provider:disabled { opacity:0.55; }
.login-provider-logo { width:20px; height:24px; margin-right:12px; flex-shrink:0; }
.auth-provider-google .login-provider-logo { height:20px; }
.login-provider-label { margin:0; padding:0; white-space:normal; flex-shrink:1; -unity-text-align:middle-center; -unity-font-style:normal; }
.login-status { margin:12px 0 0; white-space:normal; }

.login-legal { flex-direction:row; flex-wrap:wrap; justify-content:center; margin-top:8px; flex-shrink:0; }
.login-legal-link { background-color:transparent; border-width:0; border-radius:4px; color:#20201e; min-height:44px; margin:0; padding:8px; white-space:normal; -unity-text-align:middle-center; }
.login-legal-link:hover,.login-legal-link:focus { background-color:rgba(32,32,30,0.08); }
.login-legal-link:active { background-color:rgba(32,32,30,0.16); }

.paper-app .camera-notice { padding:6px 12px; background-color:#fffefa; border-radius:12px; flex-shrink:0; }
